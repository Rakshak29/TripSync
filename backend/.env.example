# TripSync Backend Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# Note: Actual .env files are ignored by git and should never contain real secrets in commits.

# Port for the Express server to listen on
# (Default is 5001 to prevent conflicts with macOS AirPlay receiver on port 5000)
PORT=5001

# Node environment: development | production | test
NODE_ENV=development

# Frontend client URL allowed by CORS (Vite default is http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas recommended for team development, or local MongoDB)
# Replace <username>, <password>, and <cluster-url> with your real credentials in your local backend/.env file
# Example Atlas format: mongodb+srv://<username>:<password>@<cluster-url>/tripsync?retryWrites=true&w=majority
# Example Local format: mongodb://localhost:27017/tripsync
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/tripsync?retryWrites=true&w=majority
